{
  "name": "chat-bullq-api",
  "version": "1.0.0",
  "description": "Chat BullQ — Omnichannel customer service API",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "typecheck": "tsc --noEmit",
    "evals": "ts-node -P tsconfig.json --transpile-only src/modules/ai-agents/evals/cli.ts",
    "evals:agent": "ts-node -P tsconfig.json --transpile-only src/modules/ai-agents/evals/cli.ts --agent",
    "ai:migrate-sakana": "ts-node prisma/scripts/migrate-agents-to-sakana.ts",
    "set-super-admin": "ts-node scripts/set-super-admin.ts"
  },
  "type": "commonjs",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.1.0",
    "@prisma/client": "^6.0.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "eta": "^4.6.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.0.0",
    "minio": "^8.0.7",
    "openai": "^6.35.0",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "passport-jwt": "^4.0.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.20.0",
    "playwright": "^1.61.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.0",
    "resend": "^6.18.1",
    "rxjs": "^7.8.0",
    "web-push": "^3.6.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.0",
    "jest": "^29",
    "prisma": "^6.0.0",
    "ts-jest": "^29",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  }
}
