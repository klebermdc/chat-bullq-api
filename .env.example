NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://bravy:bravy123@localhost:5432/chat_bullq

# JWT
JWT_SECRET=change-me-generate-with-node-e-require-crypto-randomBytes-64-toString-hex
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-generate-another-different-one
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS
CORS_ORIGIN=http://localhost:3000

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=bravy
MINIO_SECRET_KEY=bravy123minio
MINIO_BUCKET=chat-bullq

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bravy.com

OPENAI_API_KEY=sk-proj-your-key-here

# Groq — transcrição de áudio (Whisper large v3 turbo)
GROQ_API_KEY=gsk_sua-chave-groq-aqui

# Sakana LLM (Fugu / Fugu Ultra)
SAKANA_API_KEY=sk-sakana-your-key-here
SAKANA_BASE_URL=https://api.sakana.ai/v1
SAKANA_TIMEOUT_MS=120000

# Chave-mestra para criptografar as API keys salvas no banco (32 bytes hex).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_SECRET=troque_por_64_hex_chars
