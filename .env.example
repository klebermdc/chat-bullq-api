NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://bravy:bravy123@localhost:5432/chat_bullq

# JWT
JWT_SECRET=change-me-generate-with-node-e-require-crypto-randomBytes-64-toString-hex
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-generate-another-different-one
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS
CORS_ORIGIN=http://localhost:3000

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=bravy
MINIO_SECRET_KEY=bravy123minio
MINIO_BUCKET=chat-bullq

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bravy.com

OPENAI_API_KEY=sk-proj-your-key-here

# Groq — transcrição de áudio (Whisper large v3 turbo)
GROQ_API_KEY=gsk_sua-chave-groq-aqui

# Sakana LLM (Fugu / Fugu Ultra)
SAKANA_API_KEY=sk-sakana-your-key-here
SAKANA_BASE_URL=https://api.sakana.ai/v1
SAKANA_TIMEOUT_MS=120000

# Chave-mestra para criptografar as API keys salvas no banco (32 bytes hex).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_SECRET=troque_por_64_hex_chars

# OFP Hub (ai-report) — Relatórios de Vendas
# Chave admin da edge function ai-report (fica só no backend).
OFP_API_KEY=
OFP_BASE_URL=https://eypbkwmmoitaprtinpjg.supabase.co/functions/v1/ai-report
# Sincronização OFP: liga o cron horário (pull da API para o banco).
OFP_SYNC_CRON_ENABLED=false
# Fonte dos relatórios: 'db' (lê do banco após sincronizar) ou 'live' (chama a API a cada request).
OFP_REPORTS_SOURCE=db

# Proposta — Renderização Headless (Playwright + Chromium)
# Delay (ms) após page load antes de ler o carrinho renderizado.
PROPOSAL_RENDER_DELAY_MS=1000
# Hard timeout (ms) para a renderização headless.
PROPOSAL_RENDER_TIMEOUT_MS=20000
# Caminho do Chromium no sistema (deixar vazio localmente; Docker: /usr/bin/chromium-browser).
# PROPOSAL_CHROMIUM_PATH=/usr/bin/chromium-browser
# Allowlist de hosts (separados por vírgula) que podem ser renderizados como checkout.
# Proteção contra SSRF: URLs de host fora desta lista são rejeitadas.
PROPOSAL_ALLOWED_HOSTS=reservas.orlandofastpass.com.br

# WhatsApp Embedded Signup (app da plataforma / Tech Provider)
# App da Meta que faz o onboarding dos números dos clientes.
WA_APP_ID=
WA_APP_SECRET=
# Config do Cadastro Incorporado (Meta → Provedor de Tecnologia → "Personalize um novo fluxo").
WA_ES_CONFIG_ID=
# Token de verificação do webhook — o mesmo cadastrado no app da plataforma.
WA_VERIFY_TOKEN=
WA_API_VERSION=v24.0
# PIN de 6 dígitos usado no POST /{phone_number_id}/register da Cloud API.
# Sem ele o número conecta mas NÃO envia mensagem.
WA_REG_PIN=
