# Voz da Aline — infraestrutura (F1)
# Copie para .env na VPS (/opt/voz/.env). Nunca commitar o .env.

# Domínios (DNS A → IP da VPS)                                
LIVEKIT_DOMAIN=livekit.sendtur.com.br
SIP_DOMAIN=sip.sendtur.com.br

# Chave da API do LiveKit (gerar com: scripts/gerar-chaves.sh)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Redis próprio da voz (NÃO é o redis da produção)
VOICE_REDIS_PORT=6380

# Portas de mídia (faixas estreitas; precisam bater com o ufw)
LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_START=50000
LIVEKIT_RTC_UDP_END=50200
SIP_TLS_PORT=5061
SIP_RTP_START=10000
SIP_RTP_END=10200

# Certificado do SIP_DOMAIN emitido pelo Caddy da produção (montado só leitura)
# Diretório dos dados do Caddy no host (volume do chat-ofp-caddy-1, conferido em 13/11/2026)
CADDY_DATA_DIR=/var/lib/docker/volumes/chat-ofp_caddydata/_data

# Limites para proteger a produção (soma dos containers de voz)
VOICE_CPUS_LIVEKIT=1.0
VOICE_MEM_LIVEKIT=1536m
VOICE_CPUS_SIP=0.75
VOICE_MEM_SIP=1024m
VOICE_CPUS_REDIS=0.25
VOICE_MEM_REDIS=256m
VOICE_CPUS_SPEACHES=2.0
VOICE_MEM_SPEACHES=3072m
SPEACHES_THREADS=2

# Speaches (STT + TTS) — chave interna (gerar: openssl rand -hex 24)
SPEACHES_API_KEY=

# Agente de voz (F2)
VOICE_CPUS_AGENT=1.0
VOICE_MEM_AGENT=1536m
STT_MODEL=Systran/faster-whisper-small
STT_LANGUAGE=pt
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=pf_dora
# LLM compatível com OpenAI (MiniMax da agência)                      [PENDENTE]
LLM_BASE_URL=https://api.minimax.io/v1
LLM_API_KEY=
LLM_MODEL=

# STT/TTS fora da VPS (Mac mini com mlx-audio, pela ponte "mac"). Sem estas
# linhas, o agente usa o Speaches da VPS.
# STT_BASE_URL=http://172.22.0.1:18001/v1
# STT_API_KEY=mac-local
# STT_MODEL=mlx-community/whisper-large-v3-turbo-asr-fp16
# TTS_BASE_URL=http://172.22.0.1:18001/v1
# TTS_API_KEY=mac-local
# TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-8bit
# TTS_VOICE=serena
# TTS_EXTRA_BODY='{"lang_code":"portuguese","stream":true,"streaming_interval":0.5}'
